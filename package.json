{
	"name": "@oomfware/kempt",
	"version": "0.1.1",
	"description": "keeps your (generated) code presentable",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/kempt"
	},
	"files": [
		"dist/",
		"src/"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
