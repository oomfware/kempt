		"dev": "tsdown --watch",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^25.9.4",
		"bumpp": "^11.1.0",
		"fast-check": "^4.8.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"oxlint-tsgolint": "^0.23.0",
		"prettier": "^3.9.0",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
